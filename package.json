{
  "name": "dayline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "test": "node --test test/*.test.js",
    "deploy:web": "npm run build && wrangler pages deploy dist",
    "deploy:push": "wrangler deploy --config worker/wrangler.toml",
    "keys": "node scripts/keys.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "wrangler": "^4.151.1"
  }
}
